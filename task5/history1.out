    4  sudo useradd -g curators curator1
    5  sudo useradd -g curators curator2
    6  sudo grep -E 'devs|curators' /etc/group
    7  sudo groupadd -g 5500 devs
    8  sudo grep -E 'devs|curators' /etc/group
    9  sudo useradd -u 5501 -g devs user1
